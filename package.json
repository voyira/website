{
  "name": "voyira-web",
  "version": "1.0.0",
  "private": true,
  "description": "Voyira software studio — English and Turkish one-page website",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs dist",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs && npm run format:check",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "format": "prettier --write \"**/*.{js,mjs,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,css,html,json,md}\"",
    "verify": "npm run check && npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "prettier": "3.9.10"
  }
}
